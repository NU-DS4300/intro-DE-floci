# Credentials for the emulator. The access key is 12 digits on purpose:
# Floci reads a 12-digit key as the AWS account id, and the Glue Iceberg REST
# catalog uses the account id as its `warehouse` value.
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
